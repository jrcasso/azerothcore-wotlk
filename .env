# Local build tag so we never collide with the official published images
DOCKER_IMAGE_TAG=playerbots

# Container uid/gid. Must NOT be the macOS 501:20 — GID 20 is dialout in ubuntu:24.04
# and addgroup fails (exit 21). Docker Desktop on macOS virtualizes bind-mount
# ownership, so these need not match the host user.
DOCKER_USER=acore
DOCKER_USER_ID=1000
DOCKER_GROUP_ID=1000

DOCKER_DB_ROOT_PASSWORD=password

DOCKER_WORLD_EXTERNAL_PORT=8085
DOCKER_SOAP_EXTERNAL_PORT=7878
DOCKER_AUTH_EXTERNAL_PORT=3724
DOCKER_DB_EXTERNAL_PORT=3306
